@page
@model TheRacingSim.Pages.InputDataModel
@{

}
<br>
<div class="card text-white bg-dark mb-3" style="max-width: 80%;">
    <div class="card-header">Season Standings</div>
        <div class="card-body">
            <form>
                <fieldset>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="series">Series</label>
                        <select id="">
                            <option>NASCAR Cup</option>
                            <option>NASCAR Busch</option>
                            <option>NASCAR Trucks</option>
                            <option>NASCAR ARCA</option>
                            <option>NASCAR ARCA East</option>
                            <option>NASCAR ARCA West</option>
                            <option>Cars Tour Late Models</option>
                            <option>Cars Tour Pro Late Models</option>
                            <option>IndyCar</option>
                            <option>Indy NXT/Lights</option>
                            <option>USF2000 Championship</option>
                            <option>IMSA GTP</option>
                            <option>IMSA LMP2</option>
                            <option>IMSA GTD Pro</option>
                            <option>IMSA GTD</option>
                            <option>Formula 1</option>
                            <option>Formula 2</option>
                            <option>Formula 3</option>
                        </select>
                    </div>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="year">Year</label>
                        <input style="width:20%;" id="year" class="form-control form-control-sm" type="number">
                    </div>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="pos1">Season Results Top 20</label>
                        <table>
                            <tr>
                                <th>Driver</th>
                                <th>Wins</th>
                            </tr>
                            @for(int i=1; i<=20; i++){
                                string posID = "pos" + i.ToString();
                                string winsID = "wins" + i.ToString();
                                <tr>
                                    <td style="width:80%;"><input class="form-control form-control-sm" type="text" id="@posID"></td>
                                    <td class="width:20%;"><input class="form-control form-control-sm" type="number" id="@winsID"></td>
                                </tr>
                            }
                        </table>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>
<br>
<div class="card text-white bg-dark mb-3" style="max-width: 80%;">
    <div class="card-header">Input A New Season</div>
        <div class="card-body">
            <form>
                <fieldset>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="series">Series</label>
                        <select id="">
                            <option>NASCAR Cup</option>
                            <option>NASCAR Busch</option>
                            <option>NASCAR Trucks</option>
                            <option>NASCAR ARCA</option>
                            <option>NASCAR ARCA East</option>
                            <option>NASCAR ARCA West</option>
                            <option>Cars Tour Late Models</option>
                            <option>Cars Tour Pro Late Models</option>
                            <option>IndyCar</option>
                            <option>Indy NXT/Lights</option>
                            <option>USF2000 Championship</option>
                            <option>IMSA GTP</option>
                            <option>IMSA LMP2</option>
                            <option>IMSA GTD Pro</option>
                            <option>IMSA GTD</option>
                            <option>Formula 1</option>
                            <option>Formula 2</option>
                            <option>Formula 3</option>
                        </select>
                    </div>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="series">Series</label>
                        <select id="">
                            <option>Tracks DB Table Integration Coming Soon...</option>
                        </select>
                    </div>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="year">Year</label>
                        <input style="width:20%;" id="year" class="form-control form-control-sm" type="number">
                    </div>
                    <div>
                        <label class="col-form-label col-form-label-sm mt-4" for="pos1">Season Results Top 20</label>
                        <table>
                            <tr>
                                <th>#</th>
                                <th>Event Name</th>
                                <th>Laps</th>
                            </tr>
                            @for(int i=1; i<=36; i++){
                                string numberID = "number" + i.ToString();
                                string eventNameID = "eventName" + i.ToString();
                                string lapsID = "laps" + i.ToString();
                                <tr>
                                    <td style="width:20%;"><input class="form-control form-control-sm" type="number" id="@numberID"></td>
                                    <td style="width:60%;"><input class="form-control form-control-sm" type="text" id="@eventNameID"></td>
                                    <td class="width:20%;"><input class="form-control form-control-sm" type="number" id="@lapsID"></td>
                                </tr>
                            }
                        </table>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>